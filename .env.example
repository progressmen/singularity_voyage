# Singularity Voyage 本地环境变量（已被 .gitignore 忽略，勿提交）
# 模型 / Web 搜索 / 邮件提醒统一在 /sv 设置页配置，保存到 $DSH_HOME/sv/config.json；
# 本文件只保留部署级开关（会话库、MCP 解释器、桌面控制等）。

# ── 会话持久化（PostgreSQL，可选）───────────────────────────────────────
# 配置后会话索引与对话记录写入 PostgreSQL（表结构自动创建）；留空则用本地文件。
SV_DATABASE_URL=postgresql://postgres:postgres123456@127.0.0.1:5432/postgres?connect_timeout=5


# ── 邮件提醒 ────────────────────────────────────────────────────────────
# SMTP 配置（账号/密码/收发件人/摘要时间等）统一在 /sv 设置页填写，
# 保存在 $DSH_HOME/sv/config.json，这里不再重复。
# 邮件 MCP 服务的 Python 解释器（默认 python3）
SV_MAIL_PYTHON=.venv/bin/python


# ── 每日简报 ────────────────────────────────────────────────────────────
# 默认每天 08:30 生成并写入收件箱；开关/时间/邮件选项也可在 /sv 设置页修改，
# 保存后的 config.json 优先于这里。
SV_BRIEFING_ENABLED=true
SV_BRIEFING_AT=08:30
SV_BRIEFING_EMAIL=false


# ── 股票行情 MCP（可选）────────────────────────────────────────────────
# 只读 A 股行情（akshare），依赖装在 mcp/sv-stock-mcp/.venv（见 README 5.2）。
# 留空时 cordis.patch.yml 使用上面的 .venv 解释器；需要换环境时设置：
SV_STOCK_PYTHON=mcp/sv-stock-mcp/.venv/bin/python

# ── 桌面控制（可选）────────────────────────────────────────────────────
# dsh-computer-use 以固定 argv 调用 cua-driver；不在 PATH 中时指定绝对路径。
# 还需要在系统设置的「隐私与安全性」里给 CuaDriver.app 授予辅助功能与屏幕录制。
# CUA_DRIVER_BIN=/Users/you/.local/bin/cua-driver
CUA_DRIVER_BIN=/Users/zhaoqi/.local/bin/cua-driver

# DSH 源代码路径
SV_DSH_SRC=/Users/zhaoqi/project/deepseek-harness-dsh-v0.2.1-rc.2