# Singularity Voyage 环境变量模板
#
# 复制为 .env 并填入密钥；dsh 启动时会自动加载项目根目录的 .env，
# 将其物化进 process.env（早于任何插件挂载），因此：
#   - cordis.patch.yml 中的 `!!js process.env.SV_*` 表达式可以读到
#   - sv-app 插件（src/index.ts、config-store.ts）可以读到
#
# ⚠️ 禁止出现在任何 .env 中的变量（dsh 引导层保留，写入会直接报错）：
#   - DSH_ / XDG_ / DYLD_ / BASH_FUNC_ 前缀的变量
#   - DEEPSEEK_BASE_URL、DEEPSEEK_SEARCH_BASE_URL
#   - PATH、HOME、NODE_OPTIONS、HTTP_PROXY、HTTPS_PROXY 等引导变量
#     （完整清单见 harness 的 packages/boot/app-boot/src/index.ts BOOTSTRAP_NAMES）

# ── 模型（OpenAI 兼容 API）─────────────────────────────────────────────
# 供应商预设：deepseek（默认）| qwen | ark | openai | custom
# 预设只决定默认端点与模型，页面保存后以页面为准
SV_LLM_PROVIDER=deepseek
SV_LLM_BASE_URL=https://api.deepseek.com
SV_LLM_MODEL=deepseek-chat
SV_LLM_API_KEY=

# ── Web 搜索（可选；提供方三选一）───────────────────────────────────────
# 协议：deepseek（官方 Search API，复用 SV_LLM_API_KEY）| tavily | bocha
# SV_SEARCH_PROVIDER 优先，其次 WEB_SEARCH_PROVIDER；留空时 DeepSeek 模型默认官方搜索
SV_SEARCH_PROVIDER=deepseek

# DeepSeek 官方 Search API（provider=deepseek）
# 无需单独配置密钥：未设置时自动复用 SV_LLM_API_KEY；如需独立密钥可填 DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# 韧性参数（页面配置 > 环境变量 > 内置缺省 2 / 15000 / 30000；必须为正整数）
# SV_SEARCH_RETRY_ATTEMPTS=2        # 失败后的额外重试次数
# SV_SEARCH_API_TIMEOUT_MS=15000    # 单次请求超时
# SV_SEARCH_RETRY_BUDGET_MS=30000   # 重试阶段总预算

# Tavily 兼容 API（provider=tavily）
SV_SEARCH_BASE_URL=https://api.tavily.com
SV_SEARCH_API_KEY=

# 博查原生 API（provider=bocha）；key 也可用 BOCHA_API_KEY
SV_SEARCH_BOCHA_BASE_URL=https://api.bochaai.com
SV_SEARCH_BOCHA_API_KEY=
BOCHA_FRESHNESS=oneYear

# ── 邮件提醒（可选；推荐直接在 /sv 设置页填写）──────────────────────────
# 页面保存的 $DSH_HOME/sv/config.json 优先于这里的值；QQ/163/Gmail 等
# 需要在邮箱后台开启 SMTP 并生成「应用专用密码」，不是登录密码。
# SV_MAIL_ENABLED=true
# SV_MAIL_HOST=smtp.qq.com
# SV_MAIL_PORT=465
# SV_MAIL_SECURE=true            # true = SSL（465）；false = STARTTLS（587）
# SV_MAIL_USER=you@qq.com
# SV_MAIL_PASSWORD=
# SV_MAIL_FROM=you@qq.com        # 留空回落到 SV_MAIL_USER
# SV_MAIL_TO=you@qq.com          # 留空回落到 SV_MAIL_USER，多个用英文逗号分隔
# SV_MAIL_NOTIFY_ON_REMINDER=true
# SV_MAIL_DIGEST_AT=08:30        # 每日待办摘要时间（本地时区），留空关闭
# 邮件 MCP 服务的 Python 解释器（默认 python3）
# SV_MAIL_PYTHON=python3

# ── 股票行情 MCP（可选）────────────────────────────────────────────────
# 只读 A 股行情（akshare），依赖装在 mcp/sv-stock-mcp/.venv（见 README 5.2）。
# 留空时 cordis.patch.yml 使用上面的 .venv 解释器；需要换环境时设置：
# SV_STOCK_PYTHON=mcp/sv-stock-mcp/.venv/bin/python

# ── 桌面控制（可选）────────────────────────────────────────────────────
# dsh-computer-use 以固定 argv 调用 cua-driver；不在 PATH 中时指定绝对路径。
# 还需要在系统设置的「隐私与安全性」里给 CuaDriver.app 授予辅助功能与屏幕录制。
# CUA_DRIVER_BIN=/Users/you/.local/bin/cua-driver
